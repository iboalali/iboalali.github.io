---
layout: main_layout.njk
---
<a href="/" class="app-back-link">&larr; All apps</a>

<header class="app-hero">
    <img src="/media/{{ icon }}" alt="{{ appName }} app icon" class="app-hero-icon">
    <h1 class="app-hero-name">{{ appName }}</h1>
    {% if tagline %}
    <p class="app-hero-tagline">{{ tagline }}</p>
    {% endif %}
    <div class="app-hero-ctas">
    {% if packageName %}
    <a href="https://play.google.com/store/apps/details?id={{ packageName }}&pcampaignid=MKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1&pli=1" target="_blank" class="btn-container app-hero-cta">
        <img src="/media/GetItOnGooglePlay_Badge_Web_color_English.png" alt="Download {{ appName }} from the Play Store" />
    </a>
    {% endif %}
    {% if appUrl %}
    <a href="{{ appUrl }}" rel="noopener" class="btn-container app-hero-cta">
        <img src="/media/open_app_badge.svg" alt="Open {{ appName }} in your browser" />
    </a>
    {% endif %}
    {% if repoUrl %}
    <a href="{{ repoUrl }}" target="_blank" rel="noopener" class="btn-container app-hero-cta">
        <img src="/media/github_badge.svg" alt="View {{ appName }} source on GitHub" />
    </a>
    {% endif %}
    </div>
</header>

{% if screenshots %}
{# Screenshot strip, in the Play Store's order: hero, then what the app looks
   like, then the description. A plain horizontal scroller with CSS scroll-snap
   rather than a JS carousel, deliberately: Paper mode flattens every animation
   and transition, so an autoplaying or JS-animated carousel would be broken or
   silent there, while a snap strip degrades to an ordinary scrollable row with
   no JS at all. The wrapper carries tabindex so keyboard users can scroll it in
   browsers that don't yet make scrollers focusable on their own.

   Variants come from tools/make_screenshots.py and are named
   <file>_320/_640.webp under the page's own slug. width/height are the *source*
   dimensions: they only need to encode the aspect ratio, which is the same
   whichever variant srcset picks, and that ratio is what reserves the space and
   prevents layout shift. #}
<div class="screenshot-strip" tabindex="0" role="region" aria-label="Screenshots of {{ appName }}">
    <ul class="screenshot-list">
        {% for shot in screenshots %}
        <li>
            <img
                src="/media/screenshots/{{ page.fileSlug }}/{{ shot.file }}_640.webp"
                srcset="/media/screenshots/{{ page.fileSlug }}/{{ shot.file }}_320.webp 320w, /media/screenshots/{{ page.fileSlug }}/{{ shot.file }}_640.webp 640w"
                sizes="(max-width: 480px) 62vw, 300px"
                width="1080" height="2400"
                alt="{{ shot.alt }}"
                decoding="async"{% if not loop.first %} loading="lazy"{% endif %}>
        </li>
        {% endfor %}
    </ul>
</div>
{% endif %}

<div class="app-content">
    {{ content | safe }}
</div>
